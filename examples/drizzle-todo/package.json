{
  "name": "@examples/drizzle-todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/node.ts",
    "test": "pnpm -w run test:prepare && vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "node --max-old-space-size=3072 ../../node_modules/eslint/bin/eslint.js . && oxlint ."
  },
  "dependencies": {
    "@zeltjs/adapter-node": "workspace:*",
    "@zeltjs/cli": "workspace:*",
    "@zeltjs/core": "workspace:*",
    "better-sqlite3": "12.9.0",
    "drizzle-orm": "0.45.2",
    "valibot": "catalog:",
    "@zeltjs/openapi": "workspace:*",
    "@zeltjs/validator-valibot": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "drizzle-kit": "0.31.2",
    "tsx": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "outputs": [],
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
