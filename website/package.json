{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "typecheck:docs": "bun scripts/typecheck-docs.ts",
    "check:examples": "bun scripts/check-example-excerpts.ts",
    "verify:docs": "pnpm -w nx run website:verify-docs",
    "lint:slugs": "bun scripts/check-doc-slugs.ts",
    "test:docs": "pnpm -w run test:prepare && bun scripts/extract-doc-tests.ts && vitest run",
    "test:docs:watch": "pnpm -w run test:prepare && bun scripts/extract-doc-tests.ts && vitest"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@floating-ui/react": "0.27.20",
    "@heroicons/react": "2.2.0",
    "@mdx-js/react": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "@shikijs/twoslash": "4.5.0",
    "clsx": "2.1.1",
    "docusaurus-markdown-source-plugin": "2.4.0",
    "docusaurus-plugin-llms": "0.6.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.3.0",
    "@zeltjs/adapter-cloudflare-workers": "workspace:*",
    "@zeltjs/adapter-electron": "workspace:*",
    "@zeltjs/adapter-node": "workspace:*",
    "@zeltjs/auth-jwt": "workspace:*",
    "@zeltjs/auth-session": "workspace:*",
    "@zeltjs/core": "workspace:*",
    "@zeltjs/db": "workspace:*",
    "@zeltjs/eventbus": "workspace:*",
    "@zeltjs/hono-client": "workspace:*",
    "@zeltjs/kv": "workspace:*",
    "@zeltjs/rate-limit": "workspace:*",
    "@zeltjs/redis": "workspace:*",
    "@zeltjs/testing": "workspace:*",
    "@zeltjs/validator-valibot": "workspace:*",
    "better-sqlite3": "13.0.3",
    "bullmq": "6.5.3",
    "drizzle-orm": "0.45.4",
    "postgres": "4.0.0",
    "twoslash": "0.3.9",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.156.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "nx": {
    "targets": {
      "verify-docs": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "verification",
          {
            "runtime": "bun --version"
          }
        ],
        "outputs": [],
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "@zeltjs/*"
            ]
          }
        ],
        "options": {
          "command": "pnpm --filter website typecheck:docs && pnpm --filter website check:examples",
          "cwd": "."
        }
      },
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      },
      "typecheck": {
        "outputs": [],
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
