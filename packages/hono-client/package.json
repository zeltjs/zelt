{
  "name": "@zeltjs/hono-client",
  "version": "0.0.0",
  "description": "Type-safe Hono client generator for Zelt applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeltjs/zelt.git",
    "directory": "packages/hono-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "zelt-hono": "./bin/zelt-hono.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w run test:prepare && vitest run",
    "typecheck": "node ../../scripts/typecheck-project.mjs",
    "lint": "node --max-old-space-size=3072 ../../node_modules/eslint/bin/eslint.js . && oxlint .",
    "distribution": "node ../../scripts/pack-distribution.mjs"
  },
  "peerDependencies": {
    "@zeltjs/adapter-node": "workspace:*",
    "@zeltjs/cli": "workspace:*",
    "@zeltjs/core": "workspace:*",
    "hono": "catalog:"
  },
  "dependencies": {
    "@zeltjs/decorator-metadata": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zeltjs/adapter-node": "workspace:*",
    "@zeltjs/cli": "workspace:*",
    "@zeltjs/core": "workspace:*",
    "@zeltjs/testing": "workspace:*",
    "hono": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "main": "./dist/index.cjs"
}
