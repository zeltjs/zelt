{
  "name": "@zeltjs/studio-extract",
  "version": "0.0.0",
  "description": "Studio snapshot extractor for Zelt applications",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeltjs/zelt.git",
    "directory": "packages/studio-extract"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "default": "./dist/snapshot/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w run test:prepare && vitest run",
    "typecheck": "node ../../scripts/typecheck-project.mjs",
    "lint": "node --max-old-space-size=3072 ../../node_modules/eslint/bin/eslint.js . && oxlint ."
  },
  "dependencies": {
    "consola": "3.4.2",
    "ts-pattern": "5.7.1",
    "tsx": "catalog:",
    "valibot": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:peer"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zeltjs/core": "workspace:*",
    "@zeltjs/decorator-metadata": "workspace:*",
    "@zeltjs/eventbus": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
