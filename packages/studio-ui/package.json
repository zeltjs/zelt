    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint . && oxlint ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@zeltjs/studio-extract": "workspace:*",
    "nuqs": "2.10.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-pattern": "5.7.1",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "8.1.3",
    "vitest": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
