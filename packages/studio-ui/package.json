{
  "name": "@zeltjs/studio-ui",
  "version": "0.0.0",
  "description": "Studio spatial UI for Zelt applications",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeltjs/zelt.git",
    "directory": "packages/studio-ui"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4490 --strictPort",
    "build": "tsc -b && vite build",
