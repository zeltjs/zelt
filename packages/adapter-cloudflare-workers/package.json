{
  "name": "@zeltjs/adapter-cloudflare-workers",
  "version": "0.0.0",
  "description": "Cloudflare Workers adapter for the Zelt framework",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeltjs/zelt.git",
    "directory": "packages/adapter-cloudflare-workers"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w run test:prepare && vitest run",
    "typecheck": "node ../../scripts/typecheck-project.mjs",
    "lint": "node --max-old-space-size=3072 ../../node_modules/eslint/bin/eslint.js . && oxlint .",
    "distribution": "node ../../scripts/pack-distribution.mjs"
  },
  "dependencies": {
    "@zeltjs/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260506.1",
    "@types/node": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "main": "./dist/index.cjs"
}
