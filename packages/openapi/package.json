{
  "name": "@zeltjs/openapi",
  "version": "0.0.0",
  "description": "OpenAPI schema generator for Zelt applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeltjs/zelt.git",
    "directory": "packages/openapi"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w run test:prepare && vitest run",
    "typecheck": "tsc -b",
    "lint": "node --max-old-space-size=3072 ../../node_modules/eslint/bin/eslint.js . && oxlint ."
  },
  "peerDependencies": {
    "@zeltjs/cli": "workspace:*",
    "@zeltjs/core": "workspace:*"
  },
  "dependencies": {
    "@zeltjs/decorator-metadata": "workspace:*",
    "ts-pattern": "5.7.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zeltjs/cli": "workspace:*"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "main": "./dist/index.cjs"
}
